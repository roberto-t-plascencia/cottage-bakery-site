{
  "name": "cottage-bakery-api",
  "version": "0.1.0",
  "private": true,
  "description": "Owns Supabase (Postgres + Storage), order/business validation, and admin auth. The only service that talks to the database. See ../docs/adr/0004-service-boundary.md.",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed": "node --env-file=.env --import tsx db/seed.ts",
    "gen:types": "openapi-typescript ../specs/openapi.yaml -o src/lib/api-schema.generated.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.3",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.38.0",
    "openapi-typescript": "^7.10.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^5.0.1"
  }
}
