# Copy to .env and fill in. See README.md "Supabase setup" for where the
# Supabase values come from.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Single shared admin password — see src/lib/auth.ts and
# docs/adr/0003-admin-auth.md.
ADMIN_PASSWORD=change-me

# Signs the admin JWT this service issues. Generate with:
#   openssl rand -base64 32
# Only this service ever needs to know this secret — web/ stores the
# token it gets back as an opaque string, never verifies it itself. See
# docs/adr/0004-service-boundary.md.
JWT_SECRET=change-me-too

# Port this service listens on. web/'s API_URL (web/.env.example) must
# point here for local dev.
PORT=4000

# Order confirmation / payment confirmation emails, via Resend — see
# src/lib/email.ts and docs/adr/0007-order-confirmation-email.md. Both
# are optional: if RESEND_API_KEY is unset, email sending is skipped
# (logged, not thrown) rather than failing orders or payments.
#
# https://resend.com/api-keys
RESEND_API_KEY=

# Defaults to Resend's onboarding@resend.dev shared test sender, which
# only delivers to the Resend account's own email address. Set this
# once a real sending domain is verified in Resend.
# EMAIL_FROM=Mission Valley Home Bakers <orders@yourdomain.com>

# PayPal Checkout — see src/lib/paypal.ts and
# docs/adr/0006-online-payment-paypal.md.
#
# PAYPAL_ENV controls which PayPal host this service talks to, and it is
# NOT a query param or header — sandbox and live are different hosts
# entirely. Anything other than exactly "live" (including unset) falls
# back to sandbox, so a missing PAYPAL_ENV fails safe rather than
# accidentally going live. This means PAYPAL_CLIENT_ID/SECRET must be
# from the SAME mode as PAYPAL_ENV: sandbox credentials against the live
# host (or vice versa) both fail PayPal's OAuth token request with a 401
# invalid_client, which looks identical to a wrong/corrupted credential
# and is easy to misdiagnose as one.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Identifies which webhook subscription to verify incoming events
# against — set once the webhook is configured in the PayPal dashboard.
PAYPAL_WEBHOOK_ID=
