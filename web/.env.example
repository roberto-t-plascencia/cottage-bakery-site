# Copy this file to .env for local development.
# .env is gitignored — never commit real secrets.

# Base URL of the api/ service (see ../api). In Docker Compose this is
# the service name (http://api:4000); running both services directly
# with `npm run dev` in each, it's http://localhost:4000.
API_URL="http://localhost:4000"

# web/ holds no Supabase credentials and no JWT secret anymore — those
# moved to api/.env (see ../api/.env.example) as part of the
# microservices split. See docs/adr/0004-service-boundary.md.
